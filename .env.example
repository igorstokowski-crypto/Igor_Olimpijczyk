# Skopiuj ten plik jako .env i uzupełnij dane

# Garmin Connect
GARMIN_EMAIL=twoj@email.com
GARMIN_PASSWORD=twojehaslo

# Gmail — do automatycznego odczytu kodu MFA wysyłanego przez Garmina
# (wymaga hasła aplikacji: https://myaccount.google.com/apppasswords)
# GMAIL_IMAP_EMAIL domyślnie = GARMIN_EMAIL, ustaw tylko jeśli to inny adres
GMAIL_IMAP_EMAIL=twoj@email.com
GMAIL_IMAP_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Fitatu
FITATU_EMAIL=twoj@email.com
FITATU_PASSWORD=twojehaslo

# Hevy
HEVY_API_KEY=xxxxxxxxxxxxxxxx

# Postgres — baza danych (zastępuje Google Sheets)
DATABASE_URL=postgresql://user:haslo@localhost:5432/igor_health

# Google Sheets — TYLKO do jednorazowej migracji (migrate_sheets_to_postgres.py),
# sync.py i dashboard.py ich już nie używają
SPREADSHEET_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ  # ID z URL arkusza
GOOGLE_CREDENTIALS=credentials.json           # service account JSON
